# Copy to .env and fill in. Every key is optional: without one, the site
# shows estimates for that cost instead of live prices.

# Skyscanner Flights Live Prices API (partner key from https://www.partners.skyscanner.net/)
SKYSCANNER_API_KEY=

# LiteAPI hotel rates (free sandbox key from https://dashboard.liteapi.travel/register).
# Sandbox keys start with sand_ and may return test prices.
LITEAPI_API_KEY=

# How long (minutes) to reuse an identical live search, and how many live
# searches one visitor may run per minute.
LIVE_CACHE_MINUTES=10
LIVE_REQUESTS_PER_MINUTE=20

PORT=3000
