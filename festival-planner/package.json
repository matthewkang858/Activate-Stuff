{
  "name": "festival-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Pick US music festivals by total trip cost: tickets, flights and hotels.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test 'test/*.test.js'",
    "build:airports": "node scripts/build-airports.js"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
